rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Ownership of anything under a Pad is decided by the Pad itself.
    function ownsPad(padId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/pads/$(padId)).data.ownerId == request.auth.uid;
    }

    function isValidPad(data) {
      return data.keys().hasOnly([
          'ownerId', 'title', 'description', 'icon', 'archived',
          'createdAt', 'updatedAt', 'lastOpenedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.description is string && data.description.size() <= 500
        && data.icon is string && data.icon.size() <= 30
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastOpenedAt' in data) || data.lastOpenedAt is timestamp);
    }

    function isValidNote(data) {
      return data.keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 120
        && data.content is string && data.content.size() <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSnippet(data) {
      return data.keys().hasOnly(['title', 'language', 'code', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 120
        && data.language is string && data.language.size() <= 30
        && data.code is string && data.code.size() <= 50000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasOnly([
          'title', 'description', 'status', 'priority',
          'dueDate', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.status in ['todo', 'in_progress', 'done']
        && data.priority in ['low', 'medium', 'high']
        && (data.dueDate == null || data.dueDate is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLink(data) {
      return data.keys().hasOnly([
          'title', 'url', 'description', 'category', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.url is string && data.url.size() <= 2000
        && data.url.matches('https?://.*')
        && data.description is string && data.description.size() <= 500
        && data.category in ['docs', 'repo', 'design', 'video', 'api', 'tool', 'other']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /pads/{padId} {
      allow read: if isOwner();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidPad(request.resource.data);

      allow update: if isOwner()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidPad(request.resource.data);

      allow delete: if isOwner();

      match /notes/{noteId} {
        allow read: if ownsPad(padId);

        allow create: if ownsPad(padId)
          && isValidNote(request.resource.data);

        allow update: if ownsPad(padId)
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidNote(request.resource.data);

        allow delete: if ownsPad(padId);
      }

      match /snippets/{snippetId} {
        allow read: if ownsPad(padId);

        allow create: if ownsPad(padId)
          && isValidSnippet(request.resource.data);

        allow update: if ownsPad(padId)
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidSnippet(request.resource.data);

        allow delete: if ownsPad(padId);
      }

      match /tasks/{taskId} {
        allow read: if ownsPad(padId);

        allow create: if ownsPad(padId)
          && isValidTask(request.resource.data);

        allow update: if ownsPad(padId)
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidTask(request.resource.data);

        allow delete: if ownsPad(padId);
      }

      match /links/{linkId} {
        allow read: if ownsPad(padId);

        allow create: if ownsPad(padId)
          && isValidLink(request.resource.data);

        allow update: if ownsPad(padId)
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidLink(request.resource.data);

        allow delete: if ownsPad(padId);
      }
    }

    // Everything else is denied by default.
  }
}